---
import './styles.scss';
const { 
    title,
    image,
    showBackButton = false,
} = Astro.props;

---


<header class="chat__header">
    <section class="chat__header--section">
        {showBackButton && (
            <button class="chat__header--back-btn" aria-label="Volver">
                <svg viewBox="0 0 24 24" height="24" width="24" preserveAspectRatio="xMidYMid meet" version="1.1" x="0px" y="0px" enable-background="new 0 0 24 24">
                    <path fill="currentColor" d="M12,4l1.4,1.4L7.8,11H20v2H7.8l5.6,5.6L12,20l-8-8L12,4z"></path>
                </svg>
            </button>
        )}
        <picture class="chat__header--picture">
            <img class="chat__header--image" src={image} alt={title}>
        </picture>
    
        <p>
            {title}
        </p>
    </section>
</header>

<div class="profile-pic-modal" id="profilePicModal">
    <div class="profile-pic-modal__bg"></div>
    <div class="profile-pic-modal__content">
        <img class="profile-pic-modal__img" src={image} alt={title} />
    </div>
</div>

<script>
    document.querySelectorAll('.chat__header').forEach(header => {
        const pic = header.querySelector('.chat__header--picture');
        // Find the adjacent modal for this header (in case of multiple chats on page)
        const modal = header.nextElementSibling as HTMLElement;
        
        if (pic && modal && modal.classList.contains('profile-pic-modal')) {
            pic.addEventListener('click', (e) => {
                e.stopPropagation();
                modal.classList.add('active');
            });

            modal.addEventListener('click', () => {
                modal.classList.remove('active');
            });
        }
    });
</script>