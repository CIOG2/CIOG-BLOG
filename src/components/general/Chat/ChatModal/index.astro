---
import './styles.scss';
---

<div class="chat-modal-wrapper">
    <div class="chat-modal-intro">
        <p>Esta es una historia inmersiva. Para vivir la experiencia completa, haz clic en el botón de abajo.</p>
        <button class="open-chat-btn">Abrir chat</button>
    </div>

    <dialog class="chat-dialog">
        <div class="chat-dialog-content not-prose">
            <slot />
        </div>
        <!-- Custom scrollbar overlay (replaces native) -->
        <div class="chat-scrollbar" id="chat-scrollbar" aria-hidden="true">
            <div class="chat-scrollbar__thumb" id="chat-scrollbar-thumb"></div>
        </div>
    </dialog>
</div>

<script>
    import { gsap } from "gsap";

    // ── Chat modal logic ───────────────────────────────────────
    document.querySelectorAll('.chat-modal-wrapper').forEach(wrapper => {
        const openBtn             = wrapper.querySelector('.open-chat-btn');
        const introEl             = wrapper.querySelector('.chat-modal-intro') as HTMLElement | null;
        const dialog              = wrapper.querySelector('.chat-dialog');
        const typingIndicator     = wrapper.querySelector('#chat-typing-indicator');
        const interactiveMessages = wrapper.querySelectorAll('.chat__message--interactive');
        const scrollContainer     = wrapper.querySelector('.chat-dialog-content') as HTMLElement | null;
        const scrollbarTrack      = wrapper.querySelector('#chat-scrollbar') as HTMLElement | null;
        const scrollbarThumb      = wrapper.querySelector('#chat-scrollbar-thumb') as HTMLElement | null;

        let animationTimeline = null;
        let scrollHideTimer: ReturnType<typeof setTimeout> | null = null;

        // ── Custom scrollbar ────────────────────────────────────
        function updateScrollbar() {
            if (!scrollContainer || !scrollbarTrack || !scrollbarThumb) return;

            const { scrollTop, scrollHeight, clientHeight } = scrollContainer;

            // Hide scrollbar when content fits
            if (scrollHeight <= clientHeight) {
                scrollbarTrack.style.display = 'none';
                return;
            }
            scrollbarTrack.style.display = '';

            const ratio      = clientHeight / scrollHeight;
            const thumbH     = Math.max(ratio * clientHeight, 36);  // min 36px
            const maxScroll  = scrollHeight - clientHeight;
            const thumbTop   = (scrollTop / maxScroll) * (clientHeight - thumbH);

            scrollbarThumb.style.height    = `${thumbH}px`;
            scrollbarThumb.style.transform = `translateY(${thumbTop}px)`;

            // Flash visible → auto-hide after 1.5 s
            scrollbarTrack.classList.add('chat-scrollbar--visible');
            if (scrollHideTimer) clearTimeout(scrollHideTimer);
            scrollHideTimer = setTimeout(() => {
                scrollbarTrack?.classList.remove('chat-scrollbar--visible');
            }, 1500);
        }

        function openChat() {
            if (!dialog) return;
            // @ts-ignore
            dialog.showModal();
            document.body.style.overflow = 'hidden';

            // Hide intro so it never bleeds through the dialog backdrop
            if (introEl) introEl.style.visibility = 'hidden';

            if (scrollContainer) scrollContainer.scrollTop = 0;

            // Attach scroll listener for custom scrollbar
            scrollContainer?.addEventListener('scroll', updateScrollbar, { passive: true });
        }

        function closeChat() {
            document.body.style.overflow = '';
            if (introEl) introEl.style.visibility = '';
        }

        openBtn?.addEventListener('click', () => {
            openChat();

            if (!animationTimeline && interactiveMessages.length > 0) {
                animationTimeline = gsap.timeline();
                
                interactiveMessages.forEach((msg) => {
                    const type = msg.getAttribute('data-type');
                    const isReceived = type === 'received';
                    
                    if (isReceived && typingIndicator) {
                        animationTimeline.call(() => {
                            msg.parentNode.insertBefore(typingIndicator, msg);
                            typingIndicator.style.display = 'block';
                            gsap.to(typingIndicator, { opacity: 1, y: 0, duration: 0.3 });
                            if (scrollContainer) scrollContainer.scrollTo({ top: scrollContainer.scrollHeight, behavior: 'smooth' });
                        });
                        
                        animationTimeline.to({}, { duration: 1.8 });
                        
                        animationTimeline.to(typingIndicator, { opacity: 0, y: 10, duration: 0.2 });
                        animationTimeline.call(() => {
                            typingIndicator.style.display = 'none';
                        });
                    } else {
                        animationTimeline.to({}, { duration: 0.5 });
                    }
                    
                    animationTimeline.call(() => {
                        // @ts-ignore
                        msg.style.display = 'flex';
                    });
                    animationTimeline.to(msg, { 
                        opacity: 1, 
                        y: 0, 
                        duration: 0.4, 
                        ease: "power2.out",
                        onStart: () => {
                            if (scrollContainer) scrollContainer.scrollTo({ top: scrollContainer.scrollHeight, behavior: 'smooth' });
                        }
                    });
                });
            }
        });

        // Back button inside the chat header
        wrapper.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('.chat__header--back-btn')) {
                if (dialog) {
                    // @ts-ignore
                    dialog.close();
                    closeChat();
                }
            }
        });

        dialog?.addEventListener('close', () => {
            closeChat();
        });
    });
</script>

